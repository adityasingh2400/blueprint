{
    "extends": "../config/tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "paths": {
            "@storybook-common": ["./common"]
        }
    },
    "include": ["../packages/*/src/**/*", "./**/*"],
    "exclude": ["../node_modules", "../**/node_modules", "../**/dist", "../**/lib"]
}
